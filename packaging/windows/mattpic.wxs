<!--
  Matt|Pic – MSI-Installer (WiX Toolset v5)
  Copyright (C) 2026 Mathias Ree – GPL-3.0-or-later

  Installiert pro Benutzer nach %LOCALAPPDATA%\Programs\MattPic –
  dafür sind KEINE Administratorrechte nötig (wichtig für Uni-/Büro-PCs).
  Bau: .github/workflows/release.yml (je Sprache ein MSI, danach
  embed_languages.py → ein MSI, das die Sprache des Computers wählt).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Matt|Pic"
           Manufacturer="Mathias Ree"
           Version="$(Version)"
           UpgradeCode="3d0f6b52-8a1e-4c7b-9e25-6f4a2b9c7d10"
           ProductCode="$(ProductCode)"
           Language="$(Lang)"
           Codepage="1252"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="!(loc.Description)" Codepage="1252" />
    <MajorUpgrade DowngradeErrorMessage="!(loc.Downgrade)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="MattPicIcon" SourceFile="$(sys.SOURCEFILEDIR)mattpic.ico" />
    <Property Id="ARPPRODUCTICON" Value="MattPicIcon" />
    <Property Id="ARPCOMMENTS" Value="!(loc.Comments)" />

    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)license.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="MattPic" />
      </Directory>
    </StandardDirectory>

    <!-- alle Dateien aus dem PyInstaller-Ordner -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(DistDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenuMattPic" Name="MattPic" Description="!(loc.Description)"
                  Target="[INSTALLFOLDER]MattPic.exe" WorkingDirectory="INSTALLFOLDER" Icon="MattPicIcon" />
        <RegistryValue Root="HKCU" Key="Software\MattPic" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopMattPic" Name="MattPic" Description="!(loc.Description)"
                  Target="[INSTALLFOLDER]MattPic.exe" WorkingDirectory="INSTALLFOLDER" Icon="MattPicIcon" />
        <RegistryValue Root="HKCU" Key="Software\MattPic" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="Cleanup" Directory="INSTALLFOLDER">
      <Component Id="InstallDirKey">
        <RegistryValue Root="HKCU" Key="Software\MattPic" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Matt|Pic">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Cleanup" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>
